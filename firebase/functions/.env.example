# ============================================================================
# JAZIEL.DEV — Variables de entorno para Firebase Cloud Functions (NO SUBIR .env)
# ============================================================================
# Copia este archivo como `firebase/functions/.env` antes de desplegar.

# Orígenes permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=https://jazyelae.github.io,http://localhost:5500,http://127.0.0.1:5500

# Correo destino donde recibirás los mensajes del formulario
CONTACT_RECEIVER_EMAIL=jahirarana06@gmail.com

# Configuración SMTP (ejemplo con contraseña de aplicación de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jahirarana06@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_de_16_caracteres
